# Required for script/extraction and generated visuals
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Required only by providers/features you enable
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
PEXELS_API_KEY=
DATABASE_URL=
FAL_KEY=
YOUTUBE_API_KEY=

# Optional quiz experiment: animate only the frame-zero clue with one fal/Kling clip.
QUIZ_FAL_OPENER=0
QUIZ_FAL_RATE_SEC=0.056

# Vercel Blob authentication. Either a legacy/static read-write token OR Vercel OIDC + store id works.
# Newer Vercel Storage integrations may inject BLOB_READ_WRITE_TOKEN_STORE_ID automatically while
# VERCEL_OIDC_TOKEN is supplied by the Vercel runtime. BLOB_STORE_ID is the standard alias supported
# by Vercel Blob; do not copy a store id into BLOB_READ_WRITE_TOKEN because they are different values.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN_STORE_ID=

# Private studio login. Vercel fails closed when APP_PASSWORD is empty.
APP_USERNAME=admin
APP_PASSWORD=
# Use a separate long random value in production. If omitted, the password derives the signing key.
APP_SESSION_SECRET=
APP_SESSION_TTL_SEC=43200
# APP_SHARED_SECRET remains optional for headless X-App-Secret clients.
APP_SHARED_SECRET=
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Optional provider controls
I2V_PROVIDER=
# Maximum paid alternate camera angles per long-form video; remaining cuts are local reframes.
MAX_LONGFORM_ALT_IMAGES=18
MAX_VIDEO_COST_USD=10
TOPICS_PER_FORMAT=4
# Defaults to 1 on Vercel and 0 locally. Prevents paid renders when Blob/DB persistence is missing.
REQUIRE_DURABLE_ARTIFACTS=

# Crash-safe production execution. Defaults on in Vercel; set explicitly elsewhere when desired.
DURABLE_EXECUTION=
# Independent random secrets for Vercel Cron and a headless recovery worker.
CRON_SECRET=
RENDER_WORKER_SECRET=
# Hard reservation cap per job, lease/retry policy, and maximum ambiguous in-flight provider call.
DURABLE_JOB_MAX_COST_USD=10
DURABLE_JOB_LEASE_SECONDS=900
DURABLE_JOB_MAX_ATTEMPTS=5
DURABLE_MAX_INFLIGHT_CALL_USD=1

# Controlled PR7 pilot cap. A batch always creates one fixed 45-second Standard job and one fixed
# 45-second Evidence Mystery job; this is the independent maximum for each job.
PR7_PILOT_MAX_COST_USD=10

# Controlled PR8 production cap. One 90-second video is bought per run, and only for the structure
# that already won a passed PR7 batch, so this cap is per production run rather than per batch.
PR8_PRODUCTION_MAX_COST_USD=25

# Long-form retention contract. One automatic re-plan runs before this gate. Keep hard mode on in
# production so a missing early payoff/prediction or unresolved story loop cannot consume render spend.
LONGFORM_CONTRACT_RETRIES=1
LONGFORM_RETENTION_HARD=1
# Render and grade roughly the first minute before purchasing the remaining long-form assets.
FIRST_MINUTE_GATE_HARD=1
# Required for a controlled pilot to pass. Produce this JSON from human-labeled real-video
# observations with scripts/calibrate_rendered_gate.py. If unset, provisional thresholds still
# grade diagnostics but fail closed and cannot produce a passing pilot.
LONGFORM_GATE_CALIBRATION_PROFILE=
# Calibrated pre-asset runtime planner. Override only after measuring the deployed TTS voice.
PLANNED_TTS_WORDS_PER_SECOND=1.95
PLANNED_TTS_SCENE_PAUSE_SECONDS=0.15

# Optional music object-storage overrides. The built-in CC-BY URLs are used by default;
# set URL and matching SHA-256 together when migrating a track to Vercel Blob or another CDN.
# MUSIC_UPBEAT_URL=
# MUSIC_UPBEAT_SHA256=
# MUSIC_CACHE_DIR=/tmp/reelforge/music

# Media binaries. The long-form renderer shells out to ffmpeg/ffprobe for every encode.
# Resolution order: these overrides, then PATH, then system locations, then the static
# ffmpeg bundled in the imageio-ffmpeg wheel. That wheel ships ffmpeg ONLY, so a host with
# no system package still needs ffprobe supplied (any normal `apt-get install -y ffmpeg`
# provides both). GET /api/production-readiness reports this before any render spend.
FFMPEG_BIN=
FFPROBE_BIN=
