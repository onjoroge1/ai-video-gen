# Required for script/extraction and generated visuals
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Required only by providers/features you enable
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
PEXELS_API_KEY=
DATABASE_URL=
FAL_KEY=
YOUTUBE_API_KEY=
BLOB_READ_WRITE_TOKEN=

# Private studio login. Vercel fails closed when APP_PASSWORD is empty.
APP_USERNAME=admin
APP_PASSWORD=
# Use a separate long random value in production. If omitted, the password derives the signing key.
APP_SESSION_SECRET=
APP_SESSION_TTL_SEC=43200
# APP_SHARED_SECRET remains optional for headless X-App-Secret clients.
APP_SHARED_SECRET=
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Optional provider controls
I2V_PROVIDER=
# Maximum paid alternate camera angles per long-form video; remaining cuts are local reframes.
MAX_LONGFORM_ALT_IMAGES=18
MAX_VIDEO_COST_USD=10
TOPICS_PER_FORMAT=4
# Defaults to 1 on Vercel and 0 locally. Prevents paid renders when Blob/DB persistence is missing.
REQUIRE_DURABLE_ARTIFACTS=

# Crash-safe production execution. Defaults on in Vercel; set explicitly elsewhere when desired.
DURABLE_EXECUTION=
# Independent random secrets for Vercel Cron and a headless recovery worker.
CRON_SECRET=
RENDER_WORKER_SECRET=
# Hard reservation cap per job, lease/retry policy, and maximum ambiguous in-flight provider call.
DURABLE_JOB_MAX_COST_USD=10
DURABLE_JOB_LEASE_SECONDS=900
DURABLE_JOB_MAX_ATTEMPTS=5
DURABLE_MAX_INFLIGHT_CALL_USD=1

# Long-form retention contract. One automatic re-plan runs before this gate. Keep hard mode on in
# production so a missing early payoff/prediction or unresolved story loop cannot consume render spend.
LONGFORM_CONTRACT_RETRIES=1
LONGFORM_RETENTION_HARD=1
# Render and grade roughly the first minute before purchasing the remaining long-form assets.
FIRST_MINUTE_GATE_HARD=1
# Calibrated pre-asset runtime planner. Override only after measuring the deployed TTS voice.
PLANNED_TTS_WORDS_PER_SECOND=1.95
PLANNED_TTS_SCENE_PAUSE_SECONDS=0.15

# Optional music object-storage overrides. The built-in CC-BY URLs are used by default;
# set URL and matching SHA-256 together when migrating a track to Vercel Blob or another CDN.
# MUSIC_UPBEAT_URL=
# MUSIC_UPBEAT_SHA256=
# MUSIC_CACHE_DIR=/tmp/reelforge/music
