.env
# Backups made while toggling diagnostic flags. These hold live API keys and only .env
# itself was ignored, so a `git add -A` would have pushed credentials to the remote.
.env.bak*
.env.backup*
youtube_client_secret.json
youtube_token.json

# --- generated output (13GB of renders; regenerable) ---
renders/
*.mp4
*.wav
*.aiff
__pycache__/
.DS_Store
.pytest_cache/
*.pyc
*.egg-info/
build/
dist/
myenv/
.venv/
.claude/scheduled_tasks.lock

# finished video media (5.2GB) — but KEEP the performance/metrics JSON
finished_videos/*
!finished_videos/index.json
!finished_videos/video_metrics.json
jobs/
outputs/

# Local music cache. music_assets.py checks static/music/ before the CDN, so a
# checksum-verified copy here makes local renders work offline. Deliberately NOT
# committed: bundling these MP3s is what blew up the Vercel function size.
static/music/

# Ingester scratch output. The reviewed fixture in fixtures/causal/ is the artifact;
# a committed draft beside it is a stale duplicate that reads as authoritative.
references/*.draft.json
references/transcripts/*.wav

# Cloud-sync duplicates ("file 2.py"). Six were committed by a `git add -A` and shipped 723 lines
# of exact copies into a PR; pytest also collected one and double-counted its failures.
*\ [0-9].py
*\ [0-9].md
*\ [0-9].txt
